node_modules/
*.xlsx
.DS_Store

# Build artifacts
pipelines/rust/target/

# Eval outputs and config
eval/output/
eval/output-win/
eval/models/
eval/.env
tests/eval-results.json

# Real/proprietary models + their parsed engines (public repo — never commit
# real financials, cell values, or participant names). Source .xlsx are already
# covered by *.xlsx above; this also excludes the parsed engine output dirs.
engines/

# Benchmark run detail (per-sheet/per-cell results derived from the real models
# — may contain real values/labels). Only the aggregate-only benchmarks/BASELINE.md
# is committed; raw per-run detail stays local.
benchmarks/results/

# per-sheet-eval scratch dir (transient child-process scripts + per-sheet GT)
_eval_tmp/

# Transient test artifacts (scenario save/load test writes here on every run)
tests/cli/fixtures/scenarios/

# Stale extraction artifacts
_extract*
_extracted/

# Claude Code session
.claude/
tests/uat-*/
chariot/

# Internal telemetry
project-telemetry.json
.gstack/
