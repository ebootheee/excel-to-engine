node_modules/
*.xlsx
.DS_Store

# Build artifacts
pipelines/rust/target/

# Generated engines + proprietary real models (never commit)
engines/
tests/personas/_tmp/

# Training-dataset capture + benchmark prep report (regenerable: tools/capture-dataset.mjs
# + tests/personas/run-prep.mjs are committed; their OUTPUT is not — rebuilds deterministically,
# and dataset/ may later hold real-model captures so it stays out of the public repo by default)
dataset/
tests/personas/prep-report.json
tests/personas/**/_handoff-probe/

# Eval outputs and config
eval/output/
eval/output-win/
eval/models/
eval/.env
tests/eval-results.json

# Real/proprietary models + their parsed engines (public repo — never commit
# real financials, cell values, or participant names). Source .xlsx are already
# covered by *.xlsx above; this also excludes the parsed engine output dirs.
engines/

# Benchmark run detail (per-sheet/per-cell results derived from the real models
# — may contain real values/labels). Only the aggregate-only benchmarks/BASELINE.md
# is committed; raw per-run detail stays local.
benchmarks/results/

# Efficacy fixtures: commit the SPEC (_build.mjs) + golden.json only. The generated
# chunked/ engine is parser-version-dependent (drifts when the emitter changes), so
# the harness regenerates it on demand from _build.mjs — never commit the artifact.
benchmarks/fixtures/*/chunked/

# per-sheet-eval scratch dir (transient child-process scripts + per-sheet GT)
_eval_tmp/

# Transient test artifacts (scenario save/load test writes here on every run)
tests/cli/fixtures/scenarios/

# Stale extraction artifacts
_extract*
_extracted/

# Claude Code session
.claude/
tests/uat-*/
chariot/

# Internal telemetry
project-telemetry.json
.gstack/
